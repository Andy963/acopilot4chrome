{
  "name": "acopilot4chrome",
  "version": "0.0.16",
  "description": "Chrome side-panel AI copilot for any OpenAI-compatible endpoint — bring your own key, chat with page context",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "marked-katex-extension": "^5.1.10",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/chrome": "0.2.2",
    "@types/mozilla-readability": "0.2.0",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@vue/test-utils": "2.4.6",
    "@wxt-dev/module-vue": "1.0.3",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.3.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.0.4",
    "wxt": "0.20.27"
  }
}
